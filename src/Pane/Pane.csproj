<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Pane.Protocol\Pane.Protocol.csproj" />
    <ProjectReference Include="..\Pane.Media\Pane.Media.csproj" />
  </ItemGroup>

  <!-- The published host exe is staged into embed/ by scripts/build.ps1 and embedded here, so Pane.exe is
       the only file anyone needs: it can install the host on any PC it runs on. -->
  <ItemGroup Condition="Exists('embed\PaneHost.exe')">
    <EmbeddedResource Include="embed\PaneHost.exe">
      <LogicalName>PaneHost.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Pane</AssemblyName>
    <RootNamespace>Pane</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\pane.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
