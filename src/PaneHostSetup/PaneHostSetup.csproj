<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PaneHostSetup</AssemblyName>
    <RootNamespace>PaneHostSetup</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- The published host exe is staged into embed/ by scripts/build.ps1 and embedded here,
       so the resulting PaneHostSetup.exe is genuinely a single double-clickable file. -->
  <ItemGroup Condition="Exists('embed\PaneHost.exe')">
    <EmbeddedResource Include="embed\PaneHost.exe">
      <LogicalName>PaneHost.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
