<UserControl x:Class="Pane.RemoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}" Focusable="True"
             FocusVisualStyle="{x:Null}">
    <Grid Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Remote screen + drop target -->
        <Grid Grid.Column="0" x:Name="ScreenHost" Background="{StaticResource Bg}"
              AllowDrop="True" Drop="ScreenHost_Drop" DragEnter="ScreenHost_DragEnter" DragLeave="ScreenHost_DragLeave">
            <Image x:Name="Screen" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="LowQuality" SnapsToDevicePixels="True"/>

            <!-- Files toggle button, top-right -->
            <Button x:Name="FilesToggle" Content="Files" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,14,0"
                    Padding="12,5" Click="FilesToggle_Click"/>

            <!-- Drag hint -->
            <Border x:Name="DropHint" Background="#B0000000" Visibility="Collapsed" IsHitTestVisible="False">
                <Border BorderBrush="{StaticResource Fg}" BorderThickness="2" CornerRadius="16"
                        Margin="40" Background="#40FFFFFF">
                    <TextBlock Text="Drop files to send to the other PC" Foreground="{StaticResource Fg}"
                               FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Border>

            <!-- Connection overlay -->
            <Border x:Name="Overlay" Background="#CC000000" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Connecting..." Foreground="{StaticResource Fg}"
                               FontSize="15" HorizontalAlignment="Center"/>
                    <Button x:Name="RetryBtn" Content="Reconnect" Style="{StaticResource GhostButton}"
                            Margin="0,16,0,0" HorizontalAlignment="Center" Visibility="Collapsed"
                            Click="Retry_Click"/>
                </StackPanel>
            </Border>

            <!-- Transfer status toast -->
            <Border x:Name="Toast" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="9" Padding="12,7" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18">
                <TextBlock x:Name="ToastText" Foreground="{StaticResource Fg}" FontSize="12"/>
            </Border>
        </Grid>

        <!-- Remote file browser -->
        <Border Grid.Column="1" x:Name="FilesPanel" Width="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <Grid Margin="12" Width="276">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="Files on the other PC" Foreground="{StaticResource Fg}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="&#x2715;" Style="{StaticResource ChromeButton}" HorizontalAlignment="Right"
                            Click="FilesToggle_Click"/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8">
                    <Button x:Name="UpBtn" Content="&#x2191; Up" Style="{StaticResource GhostButton}"
                            Padding="10,4" Click="Up_Click"/>
                    <TextBlock x:Name="PathText" Text="This PC" Foreground="{StaticResource FgDim}" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <ListBox x:Name="FileList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource Fg}" MouseDoubleClick="FileList_DoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <Button x:Name="DownloadBtn" Content="Download selected" Style="{StaticResource PillButton}"
                            HorizontalAlignment="Stretch" Click="Download_Click"/>
                    <TextBlock Text="Drag files onto the screen to send them the other way."
                               Foreground="{StaticResource FgDim}" FontSize="11" TextWrapping="Wrap" Margin="2,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
