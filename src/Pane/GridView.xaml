<UserControl x:Class="Pane.GridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,10,24,24">
        <StackPanel>
            <TextBlock Text="Your PCs" Foreground="{StaticResource FgDim}" FontSize="12"
                       Margin="4,4,0,12" TextOptions.TextFormattingMode="Display"/>
            <WrapPanel x:Name="PcPanel" Orientation="Horizontal"/>

            <TextBlock x:Name="FoundLabel" Text="Found on your network" Foreground="{StaticResource FgDim}"
                       FontSize="12" Margin="4,26,0,12" Visibility="Collapsed"/>
            <WrapPanel x:Name="FoundPanel" Orientation="Horizontal"/>

            <!-- This PC as a target: one click installs the host that's built into Pane.exe. -->
            <StackPanel x:Name="ThisPcPanel" Margin="4,26,0,0">
                <TextBlock x:Name="ThisPcText" Foreground="{StaticResource FgDim}" FontSize="12" Margin="0,0,0,10"
                           TextWrapping="Wrap" MaxWidth="460"/>
                <Button x:Name="ThisPcBtn" Content="Let this PC be controlled" Style="{StaticResource PillButton}"
                        HorizontalAlignment="Left" Click="ThisPc_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
