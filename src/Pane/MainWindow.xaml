<Window x:Class="Pane.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pane"
        Title="Pane" Height="720" Width="1120"
        MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <!-- Outer rounded shell -->
    <Border x:Name="Shell" Background="{StaticResource Bg}" CornerRadius="14" BorderBrush="{StaticResource Line}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="IntroScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Clip>
            <RectangleGeometry RadiusX="14" RadiusY="14" Rect="0,0,1120,720" x:Name="ClipGeo"/>
        </Border.Clip>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title / tab bar (also the drag area) -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_Drag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Pane" Foreground="{StaticResource Fg}"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,8,0"/>

                <!-- Tabs -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Tabs}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="chip" CornerRadius="9" Margin="3,0" Padding="12,5"
                                    Background="Transparent" MouseLeftButtonDown="Tab_Click" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource FgDim}"
                                               x:Name="label" FontSize="13" VerticalAlignment="Center"/>
                                    <Button Content="&#x2715;" Style="{StaticResource ChromeButton}"
                                            Width="18" Height="18" Margin="8,0,-4,0" FontSize="10"
                                            Click="TabClose_Click"
                                            Visibility="{Binding Closable, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="chip" Property="Background" Value="{StaticResource Surface}"/>
                                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource Fg}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Window buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,8,0" VerticalAlignment="Center">
                    <Button Content="&#x2013;" Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button x:Name="MaxBtn" Content="&#x25A1;" Style="{StaticResource ChromeButton}" Click="Maximize_Click" ToolTip="Maximize"/>
                    <Button Content="&#x2715;" Style="{StaticResource ChromeButton}" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- Active tab content -->
            <ContentControl x:Name="ContentHost" Grid.Row="1" Content="{Binding SelectedContent}"
                            RenderTransformOrigin="0.5,0.5">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="ContentSlide"/>
                </ContentControl.RenderTransform>
            </ContentControl>

            <!-- Intro overlay: a wordmark that breathes in, then clears -->
            <Border x:Name="Intro" Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource Bg}">
                <TextBlock x:Name="IntroWord" Text="Pane" Foreground="{StaticResource Fg}"
                           FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="IntroWordScale" ScaleX="0.9" ScaleY="0.9"/>
                            <TranslateTransform x:Name="IntroWordMove" Y="6"/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Border>
        </Grid>
    </Border>
</Window>
